{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acer-console/module-manifest-v2",
  "title": "Acer Console 自定义模块清单 v2（草案，见 docs/自定义模块接口-草案-v0.md）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "entry", "files", "protocol"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$", "not": { "enum": ["acer", "console", "system"] } },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
    "publisher": { "type": "string", "maxLength": 60 },
    "entry": { "$ref": "#/$defs/fileName" },
    "files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?![\\\\/])(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$))(?![A-Za-z]:)[^<>:\"|?*]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "protocol": {
      "type": "object", "additionalProperties": false, "required": ["major", "minor"],
      "properties": { "major": { "const": 1 }, "minor": { "type": "integer", "minimum": 0 } }
    },
    "icon": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "glyph": { "enum": ["puzzle", "plugin", "cube", "device", "receiver", "mouse", "key", "lamp", "fan", "shield", "bolt", "settings", "palette"] },
        "tone": { "enum": ["blue", "orange", "gray", "green", "indigo", "pink", "red", "teal"] }
      }
    },
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["hid", "network.lan", "network.internet", "fs.module", "hardware.write"] }
    },
    "ui": { "$ref": "#/$defs/fileName" }
  },
  "$defs": {
    "fileName": { "type": "string", "pattern": "^[^\\\\/:*?\"<>| ]+$" }
  }
}
